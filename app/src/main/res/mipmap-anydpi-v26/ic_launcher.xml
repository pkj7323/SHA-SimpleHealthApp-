<?xml version="1.0" encoding="utf-8"?>
<!--
  전경은 `_safe`(0.72 축소판)를 쓴다. 기본형은 마크 폭이 18~90dp라 사각·스퀴클 마스크에선
  꽉 차 보이지만 **원형 마스크에서 양쪽 원판 끝이 잘린다**(원형 세이프서클 반지름 33dp 초과).
  삼성처럼 원형 마스크를 쓰는 런처에서 아이콘이 깨져 보이는 쪽이 조금 작아 보이는 쪽보다 나쁘다.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_safe" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
